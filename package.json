{
  "name": "sys112-trainer",
  "private": true,
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "pnpm --filter @sys112/api dev",
    "dev:student": "pnpm --filter @sys112/student-web dev",
    "dev:teacher": "pnpm --filter @sys112/teacher-web dev",
    "dev:stt": "powershell -ExecutionPolicy Bypass -File scripts/start-stt.ps1",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @sys112/api db:generate",
    "db:migrate": "pnpm --filter @sys112/api db:migrate"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
