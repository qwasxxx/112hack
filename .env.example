NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://sys112:sys112@127.0.0.1:5435/sys112

JWT_SECRET=change-me-in-local-dev
JWT_EXPIRES_IN=8h

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

STT_MODE=huggingface
STT_HF_MODEL=openai/whisper-large-v3-turbo
STT_HF_LANGUAGE=russian
STT_HOST=0.0.0.0
STT_PORT=8090

LLM_PROVIDER=huggingface
# HF_TOKEN=
LLM_RUNTIME=chat
LLM_MODEL_NAME=Qwen/Qwen3.5-9B
LLM_BASE_URL=https://router.huggingface.co
LLM_HOST=0.0.0.0
LLM_PORT=8091
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.8
LLM_MAX_TOKENS=96

TTS_HOST=0.0.0.0
TTS_PORT=8092
TTS_LANGUAGE=ru

TTS_BACKEND=fish
