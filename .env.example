NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://sys112:sys112@localhost:5432/sys112

JWT_SECRET=change-me-in-local-dev
JWT_EXPIRES_IN=8h

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

AI_PROVIDER=mock
STT_PROVIDER=mock
TTS_PROVIDER=mock
EMBEDDINGS_PROVIDER=mock
EVALUATION_PROVIDER=mock

STT_MODE=local
STT_MODEL_PATH=./models/sherpa-onnx-streaming-t-one-russian-2025-09-08
STT_SAMPLE_RATE=8000
STT_NUM_THREADS=4
STT_DECODING_METHOD=greedy_search
STT_ONNX_PROVIDER=cpu
STT_ENDPOINT_RULE1=2.4
STT_ENDPOINT_RULE2=1.4
STT_ENDPOINT_CONFIRM=0.55
STT_PARTIAL_DELAY=0.5
STT_HOST=0.0.0.0
STT_PORT=8090

# Leave empty while using mock adapters.
OPENAI_API_KEY=
YANDEX_SPEECHKIT_API_KEY=
