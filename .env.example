NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://sys112:sys112@127.0.0.1:5435/sys112

JWT_SECRET=change-me-in-local-dev
JWT_EXPIRES_IN=8h

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

STT_MODE=huggingface
STT_ENGINE=hf
# STT_ENGINE=faster_whisper
# STT_FALLBACK=hf
STT_HF_MODEL=openai/whisper-large-v3-turbo
STT_HF_LANGUAGE=ru
STT_FW_MODEL=large-v3-turbo
STT_FW_DEVICE=cpu
STT_FW_COMPUTE_TYPE=int8
STT_FW_BEAM_SIZE=1
# STT_FW_THREADS=8
STT_MODEL_PATH=./models/sherpa-onnx-streaming-t-one-russian-2025-09-08
STT_SAMPLE_RATE=16000
STT_NUM_THREADS=2
STT_DECODING_METHOD=greedy_search
STT_ONNX_PROVIDER=cpu
STT_ENDPOINT_RULE1=1.2
STT_ENDPOINT_RULE2=0.7
STT_ENDPOINT_CONFIRM=0.12
STT_PARTIAL_DELAY=0.5
# Optional HuggingFace VAD / endpoint tuning (defaults shown)
# STT_HF_PREROLL_SEC=0.40
# STT_HF_MIN_SPEECH_SEC=0.14
# STT_HF_SILENCE_SEC=0.40
# STT_HF_SILENCE_FAST_SEC=0.32
# STT_HF_LONG_SPEECH_SEC=1.25
# STT_HF_SILENCE_LONG_SEC=0.34
# STT_HF_PARTIAL_SEC=1.0
# STT_HF_PARTIAL_INTERVAL_SEC=1.0
# STT_HF_TRAIL_KEEP_SEC=0.10
STT_HOST=0.0.0.0
STT_PORT=8090

LLM_PROVIDER=huggingface
# HF_TOKEN=
LLM_RUNTIME=chat
LLM_MODEL_NAME=Qwen/Qwen3.5-9B
LLM_BASE_URL=https://router.huggingface.co
LLM_HOST=0.0.0.0
LLM_PORT=8091
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.8
LLM_MAX_TOKENS=96

TTS_HOST=0.0.0.0
TTS_PORT=8092
TTS_LANGUAGE=ru

TTS_BACKEND=fish
# Fish Audio S2. Key stays in .env, never in source.
# FISH_API_KEY=
# FISH_MODEL=s2.1-pro
# FISH_LATENCY=normal
# FISH_FORMAT=pcm
# FISH_SAMPLE_RATE=44100
# FISH_REFERENCE_ID=
# FISH_REFERENCE_AUDIO=
# FISH_REFERENCE_TEXT=
# FISH_OPERATOR_REFERENCE_ID=
# FISH_VICTIM_REFERENCE_ID=
