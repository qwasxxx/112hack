NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://sys112:sys112@127.0.0.1:5435/sys112

JWT_SECRET=change-me-in-local-dev
JWT_EXPIRES_IN=8h

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

AI_PROVIDER=mock
STT_PROVIDER=mock
TTS_PROVIDER=mock
EMBEDDINGS_PROVIDER=mock
EVALUATION_PROVIDER=mock

STT_MODE=huggingface
STT_HF_MODEL=openai/whisper-large-v3-turbo
STT_HF_LANGUAGE=russian
STT_MODEL_PATH=./models/sherpa-onnx-streaming-t-one-russian-2025-09-08
STT_SAMPLE_RATE=8000
STT_NUM_THREADS=2
STT_DECODING_METHOD=greedy_search
STT_ONNX_PROVIDER=cpu
STT_ENDPOINT_RULE1=1.2
STT_ENDPOINT_RULE2=0.7
STT_ENDPOINT_CONFIRM=0.12
STT_PARTIAL_DELAY=0.5
STT_HOST=0.0.0.0
STT_PORT=8090

LLM_PROVIDER=huggingface
# HF_TOKEN=
LLM_RUNTIME=openai
LLM_MODE=local
LLM_MODEL_NAME=Qwen/Qwen3.5-9B
LLM_MODEL_PATH=./models/llm/Qwen3-4B-Q4_K_M.gguf
LLM_BASE_URL=https://router.huggingface.co
LLM_HOST=0.0.0.0
LLM_PORT=8091
LLM_LLAMA_PORT=8080
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.8
LLM_MAX_TOKENS=96
LLM_CONTEXT_SIZE=1536
LLM_N_GPU_LAYERS=0

TTS_HOST=0.0.0.0
TTS_PORT=8092
TTS_LANGUAGE=tr
TTS_DEFAULT_VOICE=tr-TR-EmelNeural
TTS_DEFAULT_EMOTION=panic_high

# Leave empty while using mock adapters. For debrief scoring, set a key to use OpenAI o3-mini.
OPENAI_API_KEY=
OPENAI_SCORE_MODEL=o3-mini
YANDEX_SPEECHKIT_API_KEY=

TTS_BACKEND=fish
# Fish Audio S2. Key stays in .env, never in source.
